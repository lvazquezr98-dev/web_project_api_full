# Copia este archivo como .env EN EL SERVIDOR (nunca en el repositorio).
# En desarrollo no hace falta: utils/config.js tiene valores por defecto.

NODE_ENV=production

# Clave con la que se firman y verifican los JWT.
# Genera una pseudoaleatoria con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=pon-aqui-tu-clave-generada

# Cadena de conexión a MongoDB y puerto del servidor (opcionales).
MONGO_URL=mongodb://127.0.0.1:27017/aroundb
PORT=3000
